# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String
MONGODB_URI=mongodb://localhost:27017/zapcoin

# JWT Configuration
JWT_SECRET=super_secret_zapcoin_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# CORS Allowed Origins (comma separated)
CORS_ORIGIN=http://localhost:5173,http://localhost:8081,http://localhost:3000

# Client App URLs
FRONTEND_URL=http://localhost:8081
ADMIN_URL=http://localhost:5173

# Pricing (fallbacks when no Token price is stored in DB)
USD_INR_RATE=88
ZAP_INR_PRICE=102
WITHDRAWAL_FEE_INR=10
